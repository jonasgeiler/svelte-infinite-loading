{
	"extends": "eslint:recommended",
	"plugins": ["svelte"],
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"parser": "svelte-eslint-parser",
			"extends": ["plugin:svelte/recommended"],
			"parserOptions": {
				"parser": "espree"
			}
		}
	],
	"parserOptions": {
		"ecmaVersion": 2020,
		"sourceType": "module"
	},
	"env": {
		"es6": true,
		"browser": true,
		"jest": true
	}
}